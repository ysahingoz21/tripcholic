// Tripcholic – Prisma schema v1 (MVP)
// Source of truth for database structure.
// Do not add community/rating/comment models here until explicitly needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum POICategory {
  HISTORICAL
  SCENIC
  FOOD
  SHOPPING
  NATURE
  NEIGHBORHOOD
  ENTERTAINMENT
}

enum BudgetLevel {
  LOW
  MEDIUM
  HIGH
}

enum TripStatus {
  PENDING
  OPTIMIZED
  FAILED
}

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips Trip[]

  @@map("users")
}

model Trip {
  id     String  @id @default(uuid())
  userId String? // nullable until auth is fully wired

  // User-facing identity
  title       String   // required — matches CreateTripDto
  description String?

  // Planning fields (single-day)
  date      DateTime
  timeStart String?  // HH:MM — optional, matches CreateTripDto.startTime
  timeEnd   String?  // HH:MM — optional, matches CreateTripDto.endTime

  // Preferences stored inline — no separate preferences table for MVP
  budgetTl           Float?   // optional, matches CreateTripDto.budgetTl
  categories         String[] // POICategory values as strings
  weather            String?  // "clear" | "cloudy" | "rainy"
  walkingToleranceKm Float?
  maxPois            Int?

  status TripStatus @default(PENDING)

  // Populated by the optimizer after a successful route generation.
  // total_distance_km cannot be recomputed from stops — must be stored.
  // total_duration_minutes is stored to avoid recalculating across stops at read time.
  // algorithm_used tracks which optimizer version produced this route.
  routeTotalDistanceKm    Float?
  routeTotalDurationMin   Int?
  routeAlgorithmUsed      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  stops TripStop[]

  @@map("trips")
}

model TripStop {
  id     String @id @default(uuid())
  tripId String
  poiId  String

  order                 Int    // stop sequence (0-based)
  arrivalTime           String // HH:MM
  departureTime         String // HH:MM
  travelTimeToNextMin   Int?   // null for the last stop
  estimatedCostTl       Float

  trip Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  poi  PointOfInterest  @relation(fields: [poiId], references: [id])

  @@unique([tripId, order])
  @@map("trip_stops")
}

model PointOfInterest {
  id       String      @id  // UUID5 derived from name — matches optimizer poi_id
  name     String      @unique
  category POICategory
  lat      Float
  lng      Float

  avgDurationMin  Int
  budgetLevel     BudgetLevel

  // Opening hours stored as HH:MM strings, matching the CSV format
  openingHoursOpen  String
  openingHoursClose String

  createdAt DateTime @default(now())

  stops TripStop[]

  @@map("points_of_interest")
}
