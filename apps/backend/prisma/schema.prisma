generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum POICategory {
  HISTORICAL
  SCENIC
  FOOD
  SHOPPING
  NATURE
  NEIGHBORHOOD
  ENTERTAINMENT
}

enum BudgetLevel {
  LOW
  MEDIUM
  HIGH
}

enum TripStatus {
  PENDING
  OPTIMIZED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips Trip[]

  @@map("users")
}

model Trip {
  id     String  @id @default(uuid())
  userId String?

  title       String
  description String?
  date        DateTime
  timeStart   String?
  timeEnd     String?
  budgetTl    Float?
  categories  String[]
  weather     String?
  walkingToleranceKm Float?
  maxPois    Int?
  status     TripStatus @default(PENDING)
  routeName            String?
  routeTotalDistanceKm Float?
  routeTotalDurationMin Int?
  routeTotalCostTl     Float?
  routeAlgorithmUsed   String?
  routeExplanation     String?
  optimizedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  stops TripStop[]

  @@index([userId])
  @@index([date])
  @@map("trips")
}

model TripStop {
  id     String @id @default(uuid())
  tripId String
  poiId  String

  order               Int
  title               String
  arrivalTime         String
  departureTime       String
  travelTimeToNextMin Int?
  estimatedCostTl     Float

  trip Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  poi  PointOfInterest @relation(fields: [poiId], references: [id], onDelete: Restrict)

  @@unique([tripId, order])
  @@index([poiId])
  @@map("trip_stops")
}

model PointOfInterest {
  id       String      @id
  name     String      @unique
  category POICategory
  description String?
  district    String?
  address     String?
  imageUrl    String?
  source      String?
  lat         Float
  lng         Float
  avgDurationMin    Int
  budgetLevel       BudgetLevel
  estimatedMinCostTl Float?
  estimatedMaxCostTl Float?
  openingHoursOpen  String
  openingHoursClose String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stops TripStop[]

  @@index([category])
  @@index([name])
  @@map("points_of_interest")
}
