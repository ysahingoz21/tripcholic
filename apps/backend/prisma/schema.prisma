generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum POICategory {
  HISTORICAL
  SCENIC
  FOOD
  SHOPPING
  NATURE
  NEIGHBORHOOD
  ENTERTAINMENT
}

enum BudgetLevel {
  LOW
  MEDIUM
  HIGH
}

enum TripStatus {
  PENDING
  OPTIMIZED
  FAILED
}

enum TripVisibility {
  PRIVATE
  PUBLIC
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  passwordHash         String
  displayName          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  trips                Trip[]
  tripLikes            TripLike[]
  tripComments         TripComment[]
  savedTrips           SavedTrip[]
  tripCompletions      TripCompletion[]
  savedTripCollections SavedTripCollection[]
  followers            UserFollow[]          @relation("UserFollowers")
  following            UserFollow[]          @relation("UserFollowing")

  @@map("users")
}

model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("user_follows")
}

model Trip {
  id     String  @id @default(uuid())
  userId String?

  title                 String
  destination           String?
  description           String?
  date                  DateTime
  timeStart             String?
  timeEnd               String?
  budgetTl              Float?
  categories            String[]
  weather               String?
  walkingToleranceKm    Float?
  maxPois               Int?
  status                TripStatus     @default(PENDING)
  visibility            TripVisibility @default(PRIVATE)
  routeName             String?
  routeTotalDistanceKm  Float?
  routeTotalDurationMin Int?
  routeTotalCostTl      Float?
  routeAlgorithmUsed    String?
  routeExplanation      String?
  optimizedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  stops    TripStop[]
  likes    TripLike[]
  comments TripComment[]
  saves    SavedTrip[]
  completions TripCompletion[]

  @@index([userId])
  @@index([date])
  @@index([visibility])
  @@map("trips")
}

model TripCompletion {
  id        String   @id @default(uuid())
  tripId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  feedbackSignals String[] @default([])

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
  @@map("trip_completions")
}

model TripStop {
  id     String @id @default(uuid())
  tripId String
  poiId  String

  order               Int
  title               String
  arrivalTime         String
  departureTime       String
  travelTimeToNextMin Int?
  estimatedCostTl     Float

  trip Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  poi  PointOfInterest @relation(fields: [poiId], references: [id], onDelete: Restrict)

  @@unique([tripId, order])
  @@index([poiId])
  @@map("trip_stops")
}

model PointOfInterest {
  id                 String      @id
  name               String      @unique
  category           POICategory
  description        String?
  district           String?
  address            String?
  imageUrl           String?
  source             String?
  lat                Float
  lng                Float
  avgDurationMin     Int
  budgetLevel        BudgetLevel
  estimatedMinCostTl Float?
  estimatedMaxCostTl Float?
  openingHoursOpen   String
  openingHoursClose  String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  stops TripStop[]

  @@index([category])
  @@index([name])
  @@map("points_of_interest")
}

model TripLike {
  id        String   @id @default(uuid())
  tripId    String
  userId    String
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
  @@map("trip_likes")
}

model TripComment {
  id        String   @id @default(uuid())
  tripId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
  @@index([userId])
  @@map("trip_comments")
}

model SavedTrip {
  id              String                    @id @default(uuid())
  tripId          String
  userId          String
  createdAt       DateTime                  @default(now())

  trip             Trip                      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionItems  SavedTripCollectionItem[]

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
  @@map("saved_trips")
}

model SavedTripCollection {
  id        String                    @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  user  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SavedTripCollectionItem[]

  @@unique([userId, name])
  @@index([userId])
  @@map("saved_trip_collections")
}

model SavedTripCollectionItem {
  id           String              @id @default(uuid())
  savedTripId  String
  collectionId String
  createdAt    DateTime            @default(now())

  savedTrip   SavedTrip           @relation(fields: [savedTripId], references: [id], onDelete: Cascade)
  collection  SavedTripCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([savedTripId, collectionId])
  @@index([savedTripId])
  @@index([collectionId])
  @@map("saved_trip_collection_items")
}
